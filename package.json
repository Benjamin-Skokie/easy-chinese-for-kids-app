{
  "name": "easy-chinese-for-kids-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build_app.mjs",
    "dev": "node scripts/dev_app.mjs",
    "test": "node --test tests/*.test.mjs",
    "audit:culture-rewrite": "node scripts/audit_culture_rewrite.mjs",
    "audit:culture-terminology": "node scripts/audit_culture_terminology.mjs",
    "sync:culture-manuscripts": "node scripts/sync_culture_manuscripts.mjs",
    "sync:culture-manuscripts:all": "node scripts/sync_culture_manuscripts.mjs --all",
    "build:culture": "node scripts/build_all_culture_pages.mjs",
    "validate:data": "node scripts/validate_learning_data.mjs",
    "audio:pinyin": "node --env-file=.env.local scripts/audio/generate-pinyin-basics.mjs",
    "audio:pinyin-basics": "node --env-file=.env.local scripts/audio/generate-pinyin-basics.mjs --chapters=1-2",
    "audio:pinyin-initials": "node --env-file=.env.local scripts/audio/generate-pinyin-basics.mjs --chapters=3-8",
    "audio:learn:manifest": "node scripts/audio/build-learn-audio-manifest.mjs",
    "audio:learn": "node --env-file=.env.local scripts/audio/generate-learn-audio.mjs",
    "audio:learn:sync": "node scripts/audio/sync-learn-recorded-audio.mjs",
    "audio:learn:boundaries": "node scripts/audio/analyze-learn-audio-boundaries.mjs",
    "audio:learn:trim-boundaries": "node scripts/audio/trim-learn-audio-boundaries.mjs",
    "check:paths": "node scripts/check_relative_paths.mjs",
    "setup:hooks": "git config core.hooksPath .githooks",
    "check": "npm run check:paths && npm run validate:data && npm run build && npm test && node --check app.js && git diff --check"
  },
  "devDependencies": {
    "esbuild": "0.25.10"
  }
}
